# Teaching Monitor - Environment Configuration
# Copy this file to .env and fill in your values

# ── Flask Configuration ──
FLASK_ENV=development              # development or production
FLASK_DEBUG=False                  # Never True in production
SECRET_KEY=change-me-to-random-32-chars

# ── Database Configuration ──
# For SQLite (local development):
DATABASE_URL=sqlite:///teaching_monitor.db

# For PostgreSQL (production):
# DATABASE_URL=postgresql://username:password@localhost:5432/teaching_monitor

# ── Server Configuration ──
SERVER_PORT=5000
SERVER_HOST=0.0.0.0

# Generate SECRET_KEY with:
# python -c "import secrets; print(secrets.token_hex(32))"
