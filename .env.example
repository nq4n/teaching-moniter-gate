# Teaching Monitor (المنارة) — Environment Configuration
# Copy this file to ".env" for LOCAL runs, and fill in real values.
# .env is gitignored and must NEVER be committed. In production (Render),
# set these same keys as the service's Environment Variables instead.
#
# These are ALL the variables the platform needs — there are no third-party
# API keys. The app talks to the database directly over DATABASE_URL (it does
# NOT use the Supabase REST API, so no Supabase anon/service keys are required).

# ── Required ──────────────────────────────────────────────────────────

# Flask session signing key. Generate a strong one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# On Render, the Blueprint auto-generates this (generateValue: true).
SECRET_KEY=change-me-to-a-random-64-char-hex

# Database connection.
# Local development (default if unset) — SQLite file:
DATABASE_URL=sqlite:///teaching_monitor.db
#
# Production — Supabase Postgres. Use the SESSION POOLER string (IPv4, port 5432);
# the direct db.<ref>.supabase.co host is IPv6-only and Render cannot reach it.
# Supabase dashboard → Connect → Session pooler. Shape:
#   DATABASE_URL=postgresql://postgres.norepvtjfxulwcvvijam:YOUR_DB_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ── Optional ──────────────────────────────────────────────────────────

# development = debug on + reloader; production = off. Default: production-safe.
FLASK_ENV=development

# Port the app listens on when run directly (python app.py). Render sets $PORT
# automatically, so you don't need this in production.
PORT=5000

# Max size of an uploaded roster / question sheet, in megabytes. Default: 8.
MAX_UPLOAD_MB=8

# Send session cookies over HTTPS only. Defaults to on when FLASK_ENV=production.
# Set to 0 only if you are deliberately serving over plain HTTP.
SESSION_COOKIE_SECURE=

# Trust X-Forwarded-* headers from the reverse proxy (Render, nginx, …). Default: 1.
# Without it the student exam link is shown as http:// on an https:// site.
TRUST_PROXY=1

# Seed a first admin account on startup (only created if it doesn't exist yet).
# Leave blank to instead register from the login page.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SCHOOL_NAME=مدرسة
